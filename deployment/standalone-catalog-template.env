###############################################
# Federated Catalog with STS + Filesystem Vault
###############################################

#keycloack properties
keycloak_admin_user=
keycloack_admin_password=
keycloack_host=
keycloack_port=
keycloack_realm=

# EDC Related configurations - In the DMS the Federated Catalog can have the same ID as the Consumer connector.

# Participant identity
edc.participant.id=
edc.iam.issuer.id=
edc.iam.did.web.use.https=
edc.iam.did.web.resolution.endpoint=
edc.iam.token.provider=
edc.iam.token.signer.privatekey.alias=
edc.iam.token.verifier.publickey.id=

# STS OAuth client
edc.iam.sts.oauth.client.id=
edc.iam.sts.oauth.client.secret.alias=
edc.iam.sts.oauth.token.url=
edc.iam.sts.oauth.scope=
edc.iam.sts.oauth.audience=

# audience
edc.oauth.validation.audience.enabled=

# Default API
web.http.port=8180 
web.http.path=/api

# Management API 
web.http.management.port=8181
web.http.management.path=/api/management
web.http.management.auth.type=tokenbased
web.http.management.auth.key=password
edc.management.context.enabled=true

# DSP
web.http.protocol.port=8182
web.http.protocol.path=/api/dsp
edc.api.dsp.enabled=true
edc.api.dsp.context.alias=protocol
edc.dsp.callback.address=http://localhost:8182/api/dsp
edc.dsp.callback.auth.audience.validation.enabled=false
edc.dsp.auth.audience.validation.enabled=false

# DCP
edc.dcp.client.credentials.enabled=false

# Control API
web.http.control.port=8183
web.http.control.path=/api/control

# Catalog API
web.http.catalog.port=8184
web.http.catalog.path=/api/catalog
edc.api.catalog.enabled=true

# Version api
web.http.version.port=8185
web.http.version.path=/api/version


